#!/usr/bin/env python3
"""Task runner for the related-stories repo — one entry point for scripts/.

  ./cli lint      [--all]
  ./cli format    [--all] [--dry]
  ./cli reconcile [--all] [--dry] [--no-force-domain-lookup]
  ./cli wrangle   [--dry]
  ./cli clip      [<url>] [--id CRASH_RECORD_ID] [--indent N]
                                        (no url: reads urls from stdin)
  ./cli info      <crash_record_id>
  ./cli archive   story <url> | stories <path>
  ./cli make      [--all] [--dry]

`./cli lint --all` is exactly `python3 scripts/lint.py --all` — the scripts stay
runnable on their own, and each subcommand's flags come from the script itself
(its add_arguments), so there is nothing here to keep in sync when one changes.

`./cli make` runs lint, format, reconcile, wrangle in that order and stops at the
first one that exits nonzero. `./cli <subcommand> --help` prints what a
subcommand does, in full, plus every flag it takes.
"""

import argparse
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent
# The scripts import each other by bare name (`from common import ...`), which
# only resolves with scripts/ on the path — as it is when they're run directly.
sys.path.insert(0, str(ROOT / "scripts"))

import archive  # noqa: E402
import colors  # noqa: E402
import clip  # noqa: E402
import format  # noqa: E402
import info  # noqa: E402
import lint  # noqa: E402
import reconcile  # noqa: E402
import wrangle  # noqa: E402

SUBCOMMANDS = (lint, format, reconcile, wrangle, clip, info)

# What `make` runs, in order, with the flags each step's main() actually accepts
# — lint takes no --dry, wrangle no --all — so `./cli make --dry` hands --dry
# only to the steps that have one. The order is load-bearing twice over: lint
# gates the steps that rewrite files, and wrangle rewrites stories.csv, whose
# mtime is the cutoff every changed-only scan measures against, so it stays last.
PIPELINE = (
    ("lint", lint.main, ("changed_only",)),
    ("format", format.main, ("changed_only", "dry")),
    ("reconcile", reconcile.main, ("changed_only", "dry")),
    ("wrangle", wrangle.main, ("dry",)),
)


def run_pipeline(changed_only=True, dry=False):
    """Run the whole pipeline, stopping at the first nonzero exit code."""
    supplied = {"changed_only": changed_only, "dry": dry}
    for name, main, accepts in PIPELINE:
        print("\n" + colors.heading(f"==> {name}"))
        code = main(**{flag: supplied[flag] for flag in accepts})
        if code:
            print(
                colors.error(f"\n{name} exited {code}; stopping"), file=sys.stderr
            )
            return code
    return 0


def build_parser():
    parser = argparse.ArgumentParser(
        prog=Path(sys.argv[0]).name,
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    # Not required: a bare `./cli` prints this help instead of a usage error.
    # Each subparser that can itself be left dangling (archive) overrides _help
    # with its own, so `./cli archive` lands on archive's help, not this one.
    parser.set_defaults(_help=parser.print_help)
    sub = parser.add_subparsers(dest="_command", metavar="<subcommand>")

    def add(name, module_doc, **kwargs):
        """One subparser, its help line and full docstring taken from the script."""
        return sub.add_parser(
            name,
            help=module_doc.splitlines()[0],
            description=module_doc,
            formatter_class=argparse.RawDescriptionHelpFormatter,
            **kwargs,
        )

    for module in SUBCOMMANDS:
        child = add(module.__name__, module.__doc__)
        module.add_arguments(child)
        child.set_defaults(_run=module.main)

    # archive brings its own story/stories subcommands, each of which sets its
    # own _run — no set_defaults here, or the nested one would have to override it.
    archive.add_arguments(add("archive", archive.__doc__))

    child = add("make", "Run lint, format, reconcile, and wrangle, in that order.")
    child.add_argument(
        "--all",
        dest="changed_only",
        action="store_false",
        help="pass --all to every step that takes it (lint, format, reconcile)",
    )
    child.add_argument(
        "--dry",
        action="store_true",
        help="pass --dry to every step that takes it (format, reconcile, wrangle)",
    )
    child.set_defaults(_run=run_pipeline)

    return parser


def main(argv=None):
    args = build_parser().parse_args(argv)
    if not hasattr(args, "_run"):  # no subcommand given
        args._help()
        return 0
    return args._run(**{k: v for k, v in vars(args).items() if not k.startswith("_")})


if __name__ == "__main__":
    sys.exit(main())
